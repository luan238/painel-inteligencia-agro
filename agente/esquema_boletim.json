{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "boletim_atual.json — formato lido pelo index.html (Germinare Market Intelligence Pro)",
  "type": "object",
  "required": ["metadata", "executive_summary", "market_indicators", "detailed_blocks_and_news",
               "weekly_evolution_wtd", "monthly_evolution_mtd", "audit_panel_projections",
               "market_intelligence_pill"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["target_regions", "scope", "timestamp", "analyst"],
      "properties": {
        "target_regions": {"type": "string", "minLength": 1},
        "scope": {"type": "string"},
        "timestamp": {"type": "string", "minLength": 1},
        "analyst": {"type": "string"}
      }
    },
    "executive_summary": {
      "type": "object",
      "required": ["cambio_energia_frete", "complexo_soja", "complexo_milho_etanol_ddgs", "complexo_algodao", "complexo_cafe"],
      "additionalProperties": {"type": "string"}
    },
    "market_indicators": {
      "type": "object",
      "required": ["cambio_e_energia", "complexo_soja", "complexo_milho_e_ddgs", "complexo_algodao", "complexo_cafe"],
      "additionalProperties": {"type": "object", "additionalProperties": {"type": "string"}}
    },
    "detailed_blocks_and_news": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "market_bias", "executive_summary", "news_sources", "strategic_directions_by_elo"],
        "properties": {
          "title": {"type": "string"},
          "market_bias": {"type": "string"},
          "executive_summary": {"type": "string"},
          "news_sources": {"type": "array", "items": {"$ref": "#/$defs/noticia"}},
          "strategic_directions_by_elo": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["elo", "direction", "reference_links"],
              "properties": {
                "elo": {"type": "string"},
                "direction": {"type": "string"},
                "reference_links": {"type": "array", "items": {"$ref": "#/$defs/link"}}
              }
            }
          }
        }
      }
    },
    "weekly_evolution_wtd": {
      "type": "object",
      "required": ["period_start", "period_end", "period_current", "assets"],
      "properties": {
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["asset", "unit", "sunday_open_ref", "current_value", "weekly_change_pct", "weekly_driver"],
            "properties": {
              "asset": {"type": "string"},
              "unit": {"type": "string"},
              "sunday_open_ref": {"type": ["number", "null"]},
              "current_value": {"type": "number"},
              "weekly_change_pct": {"type": "number"},
              "weekly_driver": {"type": "string"}
            }
          }
        }
      }
    },
    "monthly_evolution_mtd": {
      "type": "object",
      "required": ["month_start", "current_date", "days_elapsed", "daily_dates", "assets"],
      "properties": {
        "days_elapsed": {"type": "integer", "minimum": 1},
        "daily_dates": {"type": "array", "items": {"type": "string"}},
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["asset", "unit", "month_open_value", "current_value", "mtd_change_pct",
                         "monthly_narrative", "daily_history"],
            "properties": {
              "month_open_value": {"type": ["number", "null"]},
              "mid_month_10_oct": {"type": ["number", "null"]},
              "current_value": {"type": "number"},
              "mtd_change_pct": {"type": ["number", "null"]},
              "daily_history": {"type": "array", "items": {"type": ["number", "null"]}}
            }
          }
        }
      }
    },
    "audit_panel_projections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["commodity", "current_base", "short_term_target_23_oct", "end_of_month_30_oct", "audit_trigger"],
        "properties": {
          "end_of_month_30_oct": {
            "type": "object",
            "required": ["base_case", "bull_case", "bear_case"],
            "additionalProperties": {"type": "string"}
          }
        }
      }
    },
    "market_intelligence_pill": {
      "type": "object",
      "required": ["title", "formula", "analysis", "strategic_takeaway"],
      "additionalProperties": {"type": "string"}
    }
  },
  "$defs": {
    "url": {"type": "string", "pattern": "^https?://[^\\s\"'<>`]+$"},
    "link": {
      "type": "object",
      "required": ["label", "url"],
      "properties": {"label": {"type": "string"}, "url": {"$ref": "#/$defs/url"}}
    },
    "noticia": {
      "type": "object",
      "required": ["headline", "url"],
      "properties": {"headline": {"type": "string"}, "url": {"$ref": "#/$defs/url"}}
    }
  }
}
